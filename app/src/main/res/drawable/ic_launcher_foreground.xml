<?xml version="1.0" encoding="utf-8"?>
<!--
  Иконка Kelevra: то же кольцо, что и на главном экране приложения.
  Adaptive-icon обрезает края, поэтому кольцо держим в центральной трети.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M54,54m-27,0a27,27 0,1 1,54 0a27,27 0,1 1,-54 0"
        android:strokeWidth="4"
        android:strokeAlpha="1"
        android:fillColor="#00000000">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:strokeColor">
            <gradient
                android:startX="27" android:startY="27"
                android:endX="81" android:endY="81"
                android:type="linear">
                <item android:offset="0" android:color="#FF35D0A5" />
                <item android:offset="1" android:color="#FF2BA6FF" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M54,54m-19,0a19,19 0,1 1,38 0a19,19 0,1 1,-38 0"
        android:fillAlpha="0.16">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:centerX="54" android:centerY="54" android:gradientRadius="19"
                android:type="radial">
                <item android:offset="0" android:color="#8035D0A5" />
                <item android:offset="1" android:color="#0035D0A5" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
